# Port on which the local Express server listens
PORT=3001

# Allowed frontend origin(s) for CORS, comma-separated
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection string with pgvector extension enabled (e.g. Supabase connection pooler)
DATABASE_URL=postgresql://postgres.example:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Secret key used for signing and verifying JWT tokens (HMAC-SHA256)
JWT_SECRET=placeholder_jwt_secret_change_in_production_min_32_chars

# Google Gemini API key: fallback LLM provider and embeddings
GEMINI_API_KEY=placeholder_gemini_api_key

# Groq API key: primary LLM provider for the Claim Ledger and guideline drafting
GROQ_API_KEY=placeholder_groq_api_key

# Flag to enable seeded one-click demo logins for judge evaluation (set to "true")
DEMO_LOGIN_ENABLED=true

# Primary AI provider for Claim Ledger pipeline ("groq" or "gemini")
LEDGER_PRIMARY_PROVIDER=groq

# Test hook only: "gemini" or "all" simulates provider outages; leave empty
AI_FORCE_FAIL=

# Gemini model identifier for structured JSON outputs (example: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Gemini text embedding model identifier for 768-dimensional vectors
GEMINI_EMBED_MODEL=text-embedding-004

# Groq model identifier for Claim Ledger evaluation
GROQ_MODEL=llama-3.3-70b-versatile

# Optional base64/PEM certificate for strict SSL verification with Supabase connection pooler
SUPABASE_CA_CERT=
